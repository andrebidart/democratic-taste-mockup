/* Democratic Taste — MINIMAL site mockup.
   Black page, small type, lots of space. The covers are the only colour. */
:root{
  --bg:#0a0a0b; --fg:#ece9e4; --mute:#6f6b73; --line:#1c1b1f;
  --sans:'Space Grotesk',system-ui,sans-serif; --mono:'Space Mono',ui-monospace,monospace;
  --pad:clamp(16px,4vw,48px);
}
*{box-sizing:border-box}
html,body{margin:0;background:var(--bg);color:var(--fg);font-family:var(--sans);font-size:15px;-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
img{display:block;max-width:100%}
.mono{font-family:var(--mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase}
.mute{color:var(--mute)}

/* header: plain text, no boxes */
header.top{position:sticky;top:0;z-index:20;display:flex;align-items:center;gap:28px;padding:22px var(--pad);background:linear-gradient(var(--bg) 75%,transparent)}
.mark{font-family:var(--mono);font-size:12px;letter-spacing:.14em;text-transform:uppercase;margin-right:auto}
.nav{display:flex;gap:26px}
.nav a,.lang a{font-family:var(--mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--mute);transition:color .2s}
.nav a:hover,.nav a.on,.lang a.on{color:var(--fg)}
.lang{display:flex;gap:10px}
.menu-btn{display:none}
@media (max-width:760px){
  .nav{display:none}
  header.top.open .nav{display:flex;flex-direction:column;gap:18px;position:absolute;top:60px;left:0;right:0;padding:20px var(--pad) 28px;background:var(--bg);border-bottom:1px solid var(--line)}
  .menu-btn{all:unset;cursor:pointer;font-family:var(--mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--fg)}
}

main{padding:0 var(--pad)}
.sec{padding:clamp(70px,10vw,140px) 0 0}
.sec-head{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:28px}
h1,h2,h3{font-weight:500;letter-spacing:-.01em;margin:0}

/* buttons = text links with an arrow */
.link{font-family:var(--mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase;border-bottom:1px solid currentColor;padding-bottom:3px}
.link:hover{color:var(--c,var(--fg))}

/* candy: tiny, only where it means "this release" */
.candy{width:18px;height:9px;flex:none;display:inline-block;vertical-align:middle}

/* footer: link columns left, tagline right; the candy takes a random release's colour */
.foot{padding:clamp(90px,12vw,160px) var(--pad) 32px}
.foot-top{display:flex;justify-content:space-between;align-items:flex-end;gap:48px 64px;flex-wrap:wrap;margin-bottom:44px}
.foot-cols{display:grid;grid-template-columns:repeat(3,auto);gap:24px clamp(32px,5vw,72px)}
.foot-cols div{display:flex;flex-direction:column;gap:9px}
.foot-cols em{font-style:normal;font-family:var(--mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--mute);margin-bottom:4px}
.foot-cols a{color:#bdb9c1;font-size:14px;transition:color .2s}
.foot-cols a:hover{color:var(--fg)}
.foot-tag{text-align:right;margin-left:auto}
.foot-big{font-size:clamp(26px,3.6vw,48px);line-height:.95;letter-spacing:-.03em;text-transform:uppercase;font-weight:500}
.flavor-candy{all:unset;cursor:pointer;display:inline-block;vertical-align:baseline;margin-left:.2em;transition:transform .3s}
.flavor-candy .candy{width:clamp(30px,3.4vw,46px);height:auto;display:block}
.flavor-candy .candy *{fill:var(--fc,var(--fg));transition:fill .5s}
.flavor-candy:hover{transform:rotate(-14deg) scale(1.12)}
.flavor-candy.twist{animation:twist .6s cubic-bezier(.3,1.6,.5,1)}
@keyframes twist{0%{transform:rotate(0)}100%{transform:rotate(360deg)}}
.foot-sub{margin:14px 0 0;color:var(--mute);font-size:15px}
.flavor{display:inline-flex;flex-wrap:wrap;justify-content:flex-end;align-items:baseline;gap:4px 8px;margin-top:22px;padding-bottom:4px;border-bottom:1px solid var(--fc,var(--line));font-size:14px;transition:border-color .5s}
.flavor .fl-t{color:var(--fg)}
.flavor:hover .fl-t{color:var(--fc,var(--fg))}
.foot-base{display:flex;justify-content:space-between;gap:12px 20px;flex-wrap:wrap;border-top:1px solid var(--line);padding-top:18px;font-family:var(--mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--mute)}
@media (prefers-reduced-motion:reduce){ .flavor-candy.twist{animation:none} }
@media (max-width:760px){
  .foot-top{flex-direction:column-reverse;align-items:stretch}
  .foot-tag{text-align:left;margin-left:0}
  .flavor{justify-content:flex-start}
}
@media (max-width:520px){ .foot-cols{grid-template-columns:repeat(2,minmax(0,1fr))} }
